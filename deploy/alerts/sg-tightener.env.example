# sg-tightener alerting settings. Copy to ~/.sg-tightener/alerts.env, fill in, and chmod 600 it:
# it holds the Slack webhook and the SMTP password.

# Where the repository is, and the regions to watch
SG_HOME=/opt/sg-tightener
SG_REGIONS=eu-west-1

# AWS credentials: a named profile (SSO sessions expire, so use a role or long-lived profile for a service)
AWS_PROFILE=sec-prod

# Slack incoming webhook (https only). Used by watch and reconcile.
SG_REVIEW_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Email (optional): set SG_EMAIL_TO to send email as well
SG_EMAIL_TO=
SG_REVIEW_EMAIL_FROM=sg-tightener@example.com
SG_REVIEW_SMTP_HOST=smtp.example.com
SG_REVIEW_SMTP_USER=
SG_REVIEW_SMTP_PASSWORD=
